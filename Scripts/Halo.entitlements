<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime BLOCKS camera and microphone access unless the app
         declares these, even with the TCC grant in place. Without them a
         hardened-runtime build silently fails to capture and never registers in
         System Settings. Screen recording itself needs no entitlement — it is
         gated purely by TCC. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
